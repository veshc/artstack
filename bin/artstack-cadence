#!/usr/bin/env bash
# artstack-cadence - work out where today sits in the planning interval.
#
# A train runs on a calendar. Nothing in ArtStack read that calendar before
# this: art.md carried the dates and no command ever looked at them. This makes
# the dates load-bearing, so /demo-prep knows the demo is in three days and
# /inspect-adapt knows the PI is nearly over.
#
# Usage:
#   artstack-cadence                        # read context/art.md
#   artstack-cadence --art path/to/art.md
#   artstack-cadence --today 2026-10-14     # pretend, for testing
#
# It reads these lines from the Planning interval section of art.md:
#   - PI number: PI-14
#   - Dates: 2026-09-01 to 2026-12-05
#   - Iterations: 5 x 2 weeks plus 1 IP iteration
#
# Output is KEY: value lines plus one summary sentence. Missing or unparseable
# fields are reported as unknown rather than guessed, because a command acting
# on an invented iteration boundary is worse than one that admits it cannot
# tell.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

ART=""
TODAY=""

while [ $# -gt 0 ]; do
  case "$1" in
    --art) ART="${2:-}"; shift 2 ;;
    --today) TODAY="${2:-}"; shift 2 ;;
    --help|-h) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "artstack-cadence: unknown flag: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$ART" ]; then
  ART="${ARTSTACK_ART:-}"
fi
if [ -z "$ART" ]; then
  # artstack-context owns the search order (.artstack/art.md, then the legacy
  # context/art.md, then a personal fallback). Resolving it here separately
  # would drift from that order the first time either side changes.
  if [ -x "$SCRIPT_DIR/artstack-context" ]; then
    eval "$("$SCRIPT_DIR/artstack-context" 2>/dev/null || true)"
    ART="${ARTSTACK_ART:-}"
  fi
fi
if [ -z "$ART" ]; then
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  for cand in "$ROOT/.artstack/art.md" "$ROOT/context/art.md" "./context/art.md"; do
    if [ -f "$cand" ]; then ART="$cand"; break; fi
  done
fi

echo "ARTSTACK_CADENCE_PROTO: 1"

if [ -z "$ART" ] || [ ! -f "$ART" ]; then
  echo "ART_FILE: none"
  echo "PI_STATUS: unknown"
  echo "SUMMARY: No art.md found. Cadence is unknown; commands should say so rather than assume."
  exit 0
fi

echo "ART_FILE: $ART"

[ -n "$TODAY" ] || TODAY="$(date -u +%Y-%m-%d)"

# Pull the raw lines. Tolerant of bullet markers, bold and varying spacing.
PI_NUM="$(grep -iE '^[-* ]*\**PI number\**[[:space:]]*:' "$ART" 2>/dev/null | head -1 | sed 's/.*:[[:space:]]*//' | sed 's/[[:space:]]*$//' || true)"
DATES="$(grep -iE '^[-* ]*\**Dates\**[[:space:]]*:'     "$ART" 2>/dev/null | head -1 || true)"
ITERS="$(grep -iE '^[-* ]*\**Iterations\**[[:space:]]*:' "$ART" 2>/dev/null | head -1 || true)"

START="$(printf '%s' "$DATES" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -1 || true)"
END="$(printf '%s'   "$DATES" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -1 || true)"
[ "$START" = "$END" ] && END=""

# "5 x 2 weeks plus 1 IP iteration" -> count 5, length 2 weeks, IP yes.
ITER_COUNT="$(printf '%s' "$ITERS" | grep -oE '[0-9]+[[:space:]]*[xX×]' | head -1 | grep -oE '[0-9]+' || true)"
ITER_WEEKS="$(printf '%s' "$ITERS" | grep -oE '[xX×][[:space:]]*[0-9]+[[:space:]]*week' | grep -oE '[0-9]+' | head -1 || true)"
HAS_IP="false"
printf '%s' "$ITERS" | grep -qiE '\bIP\b|innovation' && HAS_IP="true"

[ -n "$PI_NUM" ] && echo "PI: $PI_NUM" || echo "PI: unknown"
echo "TODAY: $TODAY"
[ -n "$START" ] && echo "PI_START: $START" || echo "PI_START: unknown"
[ -n "$END" ]   && echo "PI_END: $END"     || echo "PI_END: unknown"
[ -n "$ITER_COUNT" ] && echo "ITERATION_COUNT: $ITER_COUNT" || echo "ITERATION_COUNT: unknown"
[ -n "$ITER_WEEKS" ] && echo "ITERATION_WEEKS: $ITER_WEEKS" || echo "ITERATION_WEEKS: unknown"
echo "HAS_IP_ITERATION: $HAS_IP"

if [ -z "$START" ] || [ -z "$END" ]; then
  echo "PI_STATUS: unknown"
  echo "SUMMARY: art.md has no parseable 'Dates: <start> to <end>' line. Cadence-aware steps should say the dates are missing and continue."
  exit 0
fi

awk -v today="$TODAY" -v start="$START" -v end="$END" \
    -v icount="${ITER_COUNT:-0}" -v iweeks="${ITER_WEEKS:-0}" -v hasip="$HAS_IP" '
function dfc(y, m, d,   era, yoe, doy, doe, yy, mm) {
  yy = y; mm = m
  if (mm <= 2) yy = yy - 1
  era = int((yy >= 0 ? yy : yy - 399) / 400)
  yoe = yy - era * 400
  doy = int((153 * (mm + (mm > 2 ? -3 : 9)) + 2) / 5) + d - 1
  doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
  return era * 146097 + doe - 719468
}
function parse(s) {
  return dfc(substr(s,1,4)+0, substr(s,6,2)+0, substr(s,9,2)+0)
}
function iso(days,   z, era, doe, yoe, y, doy, mp, d, m) {
  z = days + 719468
  era = int((z >= 0 ? z : z - 146096) / 146097)
  doe = z - era * 146097
  yoe = int((doe - int(doe/1460) + int(doe/36524) - int(doe/146096)) / 365)
  y = yoe + era * 400
  doy = doe - (365 * yoe + int(yoe/4) - int(yoe/100))
  mp = int((5 * doy + 2) / 153)
  d = doy - int((153 * mp + 2) / 5) + 1
  m = mp + (mp < 10 ? 3 : -9)
  if (m <= 2) y = y + 1
  return sprintf("%04d-%02d-%02d", y, m, d)
}
BEGIN {
  t = parse(today); s = parse(start); e = parse(end)
  if (t < s) {
    printf "PI_STATUS: not-started\n"
    printf "DAYS_TO_PI_START: %d\n", s - t
    printf "SUMMARY: %s starts in %d day(s). Planning prep is the work right now, not iteration execution.\n", (start), s - t
    exit 0
  }
  if (t > e) {
    printf "PI_STATUS: ended\n"
    printf "DAYS_SINCE_PI_END: %d\n", t - e
    printf "SUMMARY: The planning interval ended %d day(s) ago. Refresh art.md for the next PI before relying on any of this.\n", t - e
    exit 0
  }
  printf "PI_STATUS: in-progress\n"
  printf "DAYS_ELAPSED: %d\n", t - s
  printf "DAYS_TO_PI_END: %d\n", e - t

  if (icount + 0 <= 0 || iweeks + 0 <= 0) {
    printf "CURRENT_ITERATION: unknown\n"
    printf "SUMMARY: In %s, %d day(s) to the PI end. Iteration length is not stated in art.md, so iteration boundaries are unknown.\n", start "-" end, e - t
    exit 0
  }

  ilen = iweeks * 7
  printf "ITERATION_LENGTH_DAYS: %d\n", ilen
  off = t - s
  idx = int(off / ilen) + 1
  istart = s + (idx - 1) * ilen
  iend = istart + ilen - 1
  if (iend > e) iend = e

  inip = "false"
  if (idx > icount + 0) { inip = (hasip == "true" ? "true" : "false") }

  printf "CURRENT_ITERATION: %d\n", idx
  printf "ITERATION_START: %s\n", iso(istart)
  printf "ITERATION_END: %s\n", iso(iend)
  printf "DAYS_LEFT_IN_ITERATION: %d\n", iend - t
  printf "IN_IP_ITERATION: %s\n", inip
  printf "IS_LAST_ITERATION: %s\n", (idx >= icount + 0 ? "true" : "false")

  if (inip == "true") {
    printf "SUMMARY: IP iteration, %d day(s) to the PI end. This is Inspect and Adapt and hardening time, not new feature scope.\n", e - t
  } else if (iend - t <= 3) {
    printf "SUMMARY: Iteration %d of %d, %d day(s) left. The system demo is close; /demo-prep is due.\n", idx, icount + 0, iend - t
  } else {
    printf "SUMMARY: Iteration %d of %d, %d day(s) left in the iteration and %d to the PI end.\n", idx, icount + 0, iend - t, e - t
  }
}
'
