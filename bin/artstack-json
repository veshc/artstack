#!/usr/bin/env bash
# artstack-json - read fields out of JSONL, correctly.
#
# Usage:
#   artstack-json fields ts,team,command < records.jsonl   # TSV, one row each
#   artstack-json filter team=falcon < records.jsonl       # matching lines
#   artstack-json count team < records.jsonl               # value -> count
#
# Why this exists. The dashboard reads JSONL with awk, which is fine for one
# append-only log on one branch and stops being fine the moment records are
# aggregated across teams and repositories: awk pattern-matching is not
# parsing, and it gets escapes, unicode and nested values wrong in ways that
# are silent. The ART roll-up cannot be built on it.
#
# The rule is unchanged: nothing gets installed. python3 ships with macOS and
# every mainstream Linux, so it is used when it is already there, and awk is
# the fallback when it is not. A train whose machines lack python3 gets the
# awk path with a stated limitation rather than an error, and no adopter is
# asked to install a runtime.
set -euo pipefail

MODE="${1:-}"
ARG="${2:-}"
[ -n "$MODE" ] || { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

have_python() { command -v python3 >/dev/null 2>&1; }

if have_python; then
  MODE="$MODE" ARG="$ARG" python3 -c '
import json, os, sys

mode = os.environ["MODE"]
arg  = os.environ["ARG"]

def rows():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            yield json.loads(line)
        except Exception:
            # A malformed line is skipped, not fatal: one bad append must never
            # make the whole train view unreadable. It is reported on stderr so
            # the damage is visible rather than silent.
            print("artstack-json: skipping malformed line", file=sys.stderr)

if mode == "fields":
    keys = [k for k in arg.split(",") if k]
    for r in rows():
        out = []
        for k in keys:
            v = r.get(k, "")
            if isinstance(v, bool):
                v = "true" if v else "false"
            out.append(str(v) if v is not None else "")
        print("\t".join(out))

elif mode == "filter":
    if "=" not in arg:
        sys.exit("artstack-json: filter needs key=value")
    k, _, want = arg.partition("=")
    for r in rows():
        if str(r.get(k, "")) == want:
            print(json.dumps(r, separators=(",", ":")))

elif mode == "count":
    counts = {}
    for r in rows():
        v = str(r.get(arg, "")) or "-"
        counts[v] = counts.get(v, 0) + 1
    for v in sorted(counts):
        print(f"{counts[v]}\t{v}")

else:
    sys.exit(f"artstack-json: unknown mode {mode}")
'
  exit $?
fi

# ── awk fallback ──────────────────────────────────────────────
# Handles the flat string and number values ArtStack itself writes. It does not
# handle nested objects, arrays, or escaped quotes inside values, and it is not
# trying to: it is the degraded path for a machine without python3.
awk -v mode="$MODE" -v arg="$ARG" '
function jget(line, key,   re, s, p) {
  re = "\"" key "\"[ ]*:[ ]*\""
  p = match(line, re)
  if (p > 0) {
    s = substr(line, p + RLENGTH)
    if (match(s, /^([^"\\]|\\.)*/)) return substr(s, 1, RLENGTH)
    return ""
  }
  re = "\"" key "\"[ ]*:[ ]*"
  p = match(line, re)
  if (p > 0) {
    s = substr(line, p + RLENGTH)
    if (match(s, /^[^,}]+/)) return substr(s, 1, RLENGTH)
  }
  return ""
}
BEGIN { n = split(arg, keys, ",") }
{
  if ($0 ~ /^[ \t]*$/) next
  if (mode == "fields") {
    out = ""
    for (i = 1; i <= n; i++) out = out (i > 1 ? "\t" : "") jget($0, keys[i])
    print out
  } else if (mode == "filter") {
    split(arg, kv, "=")
    if (jget($0, kv[1]) == kv[2]) print $0
  } else if (mode == "count") {
    v = jget($0, arg); if (v == "") v = "-"
    c[v]++
  }
}
END { if (mode == "count") for (v in c) printf "%s\t%s\n", c[v], v }
'
