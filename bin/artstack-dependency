#!/usr/bin/env bash
# artstack-dependency - cross-team dependencies as objects with state.
#
# Usage:
#   artstack-dependency add --on orion --what "version the events API" \
#                           --by IP-2 --item 12345 [--why "..."]
#   artstack-dependency set <id> --state committed|delivered|at-risk|dropped [--note "..."]
#   artstack-dependency list [--on <team>] [--state <state>] [--mine]
#   artstack-dependency board          # the train view, grouped by owning team
#
# States, and what each one means on a train:
#   requested  we have asked; the owning team has not agreed
#   committed  the owning team agreed, with a date
#   delivered  it arrived and we confirmed it
#   at-risk    committed, but the date is in danger
#   dropped    no longer needed, or refused
#
# Why an object and not a table row. In the train file a dependency is prose:
# it cannot be queried, it has no state, nobody is notified when it slips, and
# it is refreshed once a planning interval by whoever remembers. A dependency
# that silently stayed "requested" for six weeks is the most common way a
# planning interval misses, and prose cannot tell you that happened.
#
# This does not talk to the other team. It records what this team believes and
# when it last changed, so a human can see what is stale and go and ask.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/artstack-state")"
DEPS="$ARTSTACK_STATE_DIR/train/dependencies.jsonl"

ACTION="${1:-}"
[ $# -gt 0 ] && shift || true

ON=""; WHAT=""; BY=""; ITEM=""; WHY=""; STATE=""; NOTE=""; FILTER_STATE=""; MINE=0
DEP_ID=""

case "$ACTION" in
  set) DEP_ID="${1:-}"; [ $# -gt 0 ] && shift || true ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --on) ON="${2:-}"; shift 2 ;;
    --what) WHAT="${2:-}"; shift 2 ;;
    --by) BY="${2:-}"; shift 2 ;;
    --item) ITEM="${2:-}"; shift 2 ;;
    --why) WHY="${2:-}"; shift 2 ;;
    --state) if [ "$ACTION" = "list" ]; then FILTER_STATE="${2:-}"; else STATE="${2:-}"; fi; shift 2 ;;
    --note) NOTE="${2:-}"; shift 2 ;;
    --mine) MINE=1; shift ;;
    --help|-h) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "artstack-dependency: unknown flag: $1" >&2; exit 2 ;;
  esac
done

_esc() {
  printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037' | tr '\n\r\t' '   ' \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}
_safe() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//; s/-*$//'; }
_valid_state() {
  case "$1" in requested|committed|delivered|at-risk|dropped) return 0 ;; *) return 1 ;; esac
}

case "$ACTION" in
  add)
    [ -n "$ON" ]   || { echo "artstack-dependency: --on <team> is required" >&2; exit 2; }
    [ -n "$WHAT" ] || { echo "artstack-dependency: --what is required" >&2; exit 2; }
    mkdir -p "$(dirname "$DEPS")"
    # A short stable id from the owning team plus a counter, so a human can
    # refer to one out loud in a stand-up.
    # grep -c prints 0 and exits 1 on an empty file; the `|| echo 0` fallback
    # would then yield "0\n0" and break the arithmetic.
    N=1
    [ -f "$DEPS" ] && N=$(( $(awk 'NF{n++} END{print n+0}' "$DEPS" 2>/dev/null || echo 0) + 1 ))
    DEP_ID="$(_safe "$ON")-$N"
    REC="{\"id\":\"$DEP_ID\",\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
    REC="$REC,\"from_team\":\"$(_esc "${ARTSTACK_TEAM_NAME:-unknown}")\""
    REC="$REC,\"on_team\":\"$(_esc "$ON")\",\"what\":\"$(_esc "$WHAT")\""
    REC="$REC,\"state\":\"requested\""
    [ -n "$BY" ]   && REC="$REC,\"needed_by\":\"$(_esc "$BY")\""
    [ -n "$ITEM" ] && REC="$REC,\"item\":\"$(_esc "$ITEM")\""
    [ -n "$WHY" ]  && REC="$REC,\"why\":\"$(_esc "$WHY")\""
    REC="$REC}"
    printf '%s\n' "$REC" >> "$DEPS"
    echo "DEPENDENCY: $DEP_ID requested from $ON"
    ;;

  set)
    [ -n "$DEP_ID" ] || { echo "artstack-dependency: set needs an id" >&2; exit 2; }
    _valid_state "$STATE" || { echo "artstack-dependency: --state must be requested, committed, delivered, at-risk or dropped" >&2; exit 2; }
    [ -f "$DEPS" ] || { echo "artstack-dependency: no dependencies recorded" >&2; exit 1; }
    grep -qF "\"id\":\"$DEP_ID\"" "$DEPS" || { echo "artstack-dependency: no such id: $DEP_ID" >&2; exit 1; }
    # Append-only: a transition is a new record, so the history of a dependency
    # is readable. Whether it sat in "requested" for six weeks is exactly the
    # thing a planning-interval retrospective needs to see.
    REC="{\"id\":\"$DEP_ID\",\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
    REC="$REC,\"from_team\":\"$(_esc "${ARTSTACK_TEAM_NAME:-unknown}")\""
    REC="$REC,\"state\":\"$STATE\",\"transition\":true"
    [ -n "$NOTE" ] && REC="$REC,\"note\":\"$(_esc "$NOTE")\""
    REC="$REC}"
    printf '%s\n' "$REC" >> "$DEPS"
    echo "DEPENDENCY: $DEP_ID -> $STATE"
    ;;

  list|board|"")
    [ -f "$DEPS" ] || { echo "No cross-team dependencies recorded."; exit 0; }
    "$SCRIPT_DIR/artstack-json" fields id,on_team,from_team,what,state,needed_by,item,transition,ts < "$DEPS" \
    | awk -F'\t' -v want_on="$ON" -v want_state="$FILTER_STATE" -v mine="$MINE" \
          -v me="${ARTSTACK_TEAM_NAME:-}" -v board="$([ "$ACTION" = "board" ] && echo 1 || echo 0)" '
      {
        id=$1; on=$2; from=$3; what=$4; st=$5; by=$6; it=$7; tr=$8; ts=$9
        if (tr == "true") { state[id] = st; when[id] = ts; next }
        rec_on[id]=on; rec_from[id]=from; rec_what[id]=what; rec_by[id]=by; rec_item[id]=it
        if (!(id in state)) { state[id]=st; when[id]=ts }
        order[++n]=id
      }
      END {
        if (n == 0) { print "No cross-team dependencies recorded."; exit }
        printf "%-12s %-10s %-10s %-11s %-8s %s\n", "ID", "ON TEAM", "FROM", "STATE", "BY", "WHAT"
        print "----------------------------------------------------------------------------------"
        shown=0
        for (i=1;i<=n;i++) {
          id=order[i]
          if (want_on != "" && rec_on[id] != want_on) continue
          if (want_state != "" && state[id] != want_state) continue
          if (mine == 1 && rec_from[id] != me) continue
          printf "%-12s %-10s %-10s %-11s %-8s %s\n", id, rec_on[id], rec_from[id], state[id], (rec_by[id]==""?"-":rec_by[id]), substr(rec_what[id],1,40)
          shown++
          if (state[id] == "requested") stale++
          if (state[id] == "at-risk") risk++
        }
        print "----------------------------------------------------------------------------------"
        printf "%d shown", shown
        if (stale) printf ", %d still only REQUESTED (nobody has agreed)", stale
        if (risk)  printf ", %d AT RISK", risk
        print ""
        if (stale) print "A dependency nobody agreed to is not a plan. Chase them or drop it."
      }'
    ;;

  *)
    echo "artstack-dependency: unknown action '$ACTION' (add|set|list|board)" >&2
    exit 2
    ;;
esac
