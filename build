#!/usr/bin/env bash
# build - generate skills/*/SKILL.md from skills/*/SKILL.md.tmpl
#
# Usage:
#   ./build              # regenerate every SKILL.md
#   ./build --dry-run    # generate in memory; exit 1 if any committed file differs
#   ./build --list       # list templates and the tier each one declares
#
# Why a build step. Ten commands share one set of ground rules: the open
# questions rule, the ban on inventing owners and dates, the train constraints,
# the tracker boundary. Hand-maintained, those ten copies drift the first time
# one of them changes. Here the shared text lives once in lib/partials/ and is
# composed into each SKILL.md, and CI fails if a committed file no longer
# matches its template.
#
# Why the generated file is committed rather than built at load time. Claude
# Code reads SKILL.md when the skill is invoked; there is no build step at that
# moment. The file has to already be correct on disk. Committing it also means
# `git diff` shows what actually changed in a skill's behaviour, and blame works.
#
# Dependencies: bash, sed, diff. Deliberately no runtime, no package manager,
# nothing to install. It is auditable by reading, which is the whole posture.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
PARTIALS="$ROOT/lib/partials"
SKILLS="$ROOT/skills"

DRY_RUN=0
LIST=0
case "${1:-}" in
  --dry-run) DRY_RUN=1 ;;
  --list) LIST=1 ;;
  --help|-h) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) echo "build: unknown flag: $1" >&2; exit 2 ;;
esac

BANNER='<!-- Generated from SKILL.md.tmpl by ./build - do not edit this file directly. -->'

fail() { echo "build: $*" >&2; exit 1; }

# Read a scalar key out of the template frontmatter.
frontmatter_value() {
  awk -v key="$2" '
    NR == 1 && $0 == "---" { inside = 1; next }
    inside && $0 == "---" { exit }
    inside {
      idx = index($0, ":")
      if (idx > 0) {
        k = substr($0, 1, idx - 1)
        v = substr($0, idx + 1)
        gsub(/^[ \t]+|[ \t]+$/, "", k)
        gsub(/^[ \t]+|[ \t]+$/, "", v)
        if (k == key) { print v; exit }
      }
    }
  ' "$1"
}

# Compose the preamble for a tier: tiers are cumulative, 1 through N.
emit_preamble() {
  local tier="$1" i
  case "$tier" in
    1|2|3|4) ;;
    *) fail "invalid preamble-tier '$tier' (expected 1-4)" ;;
  esac
  for i in $(seq 1 "$tier"); do
    local f="$PARTIALS/preamble-tier${i}.md"
    [ -f "$f" ] || fail "missing partial: $f"
    cat "$f"
    echo
  done
}

# Expand one template to stdout.
render() {
  local tmpl="$1"
  local tier
  tier="$(frontmatter_value "$tmpl" 'preamble-tier')"
  [ -n "$tier" ] || fail "$tmpl declares no preamble-tier"

  local in_frontmatter=1 banner_done=0 lineno=0
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))

    # Frontmatter passes through, minus the build-only directive.
    if [ "$in_frontmatter" = "1" ]; then
      case "$line" in
        preamble-tier:*) continue ;;
      esac
      printf '%s\n' "$line"
      if [ "$lineno" -gt 1 ] && [ "$line" = "---" ]; then
        in_frontmatter=0
        printf '%s\n' "$BANNER"
        banner_done=1
      fi
      continue
    fi

    case "$line" in
      '{{PREAMBLE}}')
        emit_preamble "$tier"
        ;;
      '{{'*'}}')
        local name slug f
        name="${line#\{\{}"; name="${name%\}\}}"
        slug="$(printf '%s' "$name" | tr 'A-Z_' 'a-z-')"
        f="$PARTIALS/${slug}.md"
        [ -f "$f" ] || fail "$tmpl line $lineno: no partial for {{$name}} (expected $f)"
        cat "$f"
        echo
        ;;
      *'{{'*)
        fail "$tmpl line $lineno: placeholder must be alone on its line"
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done < "$tmpl"

  [ "$banner_done" = "1" ] || fail "$tmpl has no closing frontmatter delimiter"
}

[ -d "$SKILLS" ] || fail "no skills/ directory at $SKILLS"

# Concurrency guard. A real build rewrites tracked files, so refuse to run when
# something else is mid-write in this tree. --dry-run reads only and is always
# safe, so it skips the check and stays usable in CI and in a dirty tree.
if [ "$DRY_RUN" = "0" ] && [ "$LIST" = "0" ] && [ -x "$ROOT/bin/artstack-preflight" ]; then
  if ! "$ROOT/bin/artstack-preflight" ${ARTSTACK_PREFLIGHT_WARN:+--warn-only}; then
    echo ""
    echo "build: refusing to write while this tree is unsafe."
    echo "Resolve the findings above, or set ARTSTACK_PREFLIGHT_WARN=1 to override."
    exit 1
  fi
fi

templates=()
while IFS= read -r t; do templates+=("$t"); done < <(find "$SKILLS" -mindepth 2 -maxdepth 2 -name 'SKILL.md.tmpl' | sort)
[ "${#templates[@]}" -gt 0 ] || fail "no templates found under $SKILLS"

if [ "$LIST" = "1" ]; then
  for t in "${templates[@]}"; do
    printf '%-28s tier %s\n' "$(basename "$(dirname "$t")")" "$(frontmatter_value "$t" 'preamble-tier')"
  done
  exit 0
fi

drift=0
written=0
for t in "${templates[@]}"; do
  out="${t%.tmpl}"
  tmp="$(mktemp "${TMPDIR:-/tmp}/artstack-build-XXXXXX")"
  render "$t" > "$tmp"
  if [ "$DRY_RUN" = "1" ]; then
    if [ ! -f "$out" ]; then
      echo "DRIFT: $out is missing (template exists)"
      drift=1
    elif ! diff -q "$out" "$tmp" >/dev/null 2>&1; then
      echo "DRIFT: $out does not match its template"
      diff -u "$out" "$tmp" | sed -n '1,20p' || true
      drift=1
    fi
    rm -f "$tmp"
  else
    mv "$tmp" "$out"
    chmod 644 "$out"
    written=$((written + 1))
  fi
done

if [ "$DRY_RUN" = "1" ]; then
  if [ "$drift" = "1" ]; then
    echo ""
    echo "Generated skill files are stale. Run ./build and commit the result."
    exit 1
  fi
  echo "All ${#templates[@]} skill files are current."
  exit 0
fi

echo "Generated $written skill file(s) from ${#templates[@]} template(s)."
